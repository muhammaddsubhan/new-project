# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Google Maps Platform browser key (if omitted, WashMate uses the built-in Karachi Neighborhood Coverage selector)
VITE_GOOGLE_MAPS_API_KEY=""

# Optional Pakistani Payment Gateway Credentials (JazzCash & Easypaisa)
JAZZCASH_MERCHANT_ID=""
JAZZCASH_PASSWORD=""
JAZZCASH_INTEGRITY_SALT=""
EASYPAISA_STORE_ID=""
EASYPAISA_HASH_KEY=""

# Optional WhatsApp Business Cloud API
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
